NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/estateflow
# Generate two DIFFERENT values, at least 32 chars each. Never commit .env.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (exact match, no trailing slash)
FRONTEND_URL=http://localhost:5173
# Leave empty in development
COOKIE_DOMAIN=
# SAAS or SELF_HOSTED
DEPLOYMENT_MODE=SAAS
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 = none)
TRUST_PROXY=0
AUTH_RATE_LIMIT_MAX=20
LOGIN_FAILURE_LIMIT_MAX=5